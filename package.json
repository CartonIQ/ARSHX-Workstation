{
  "name": "arshx-workstation",
  "private": true,
  "version": "1.0.0",
  "description": "ARSHX Developer Workstation - mobile-first coding workstation (React + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "android:setup": "bash scripts/setup-android.sh",
    "android:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease assembleRelease",
    "test": "tsx tests/gemini.test.mts && tsx tests/lineEditor.test.mts && tsx tests/shellAi.test.mts && tsx tests/devTools.test.mts"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
