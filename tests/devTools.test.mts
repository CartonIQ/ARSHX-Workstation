import * as d from '../src/utils/devTools.ts';
let pass = 0, fail = 0;
const t = (n: string, c: boolean) => { c ? pass++ : fail++; console.log((c ? 'PASS ' : 'FAIL ') + n); };
const throws = (f: () => any) => { try { f(); return false; } catch { return true; } };

t('json format', d.formatJson('{"a":1,"b":[1,2]}') === '{\n  "a": 1,\n  "b": [\n    1,\n    2\n  ]\n}');
t('json minify', d.minifyJson('{ "a": 1,\n "b": 2 }') === '{"a":1,"b":2}');
t('json invalid throws', throws(() => d.formatJson('{bad')));
t('base64 roundtrip utf8', d.base64Decode(d.base64Encode('héllo ✓ 世界')) === 'héllo ✓ 世界');
t('base64 known', d.base64Encode('hello') === 'aGVsbG8=');
t('base64 urlsafe no padding', d.base64Decode('aGVsbG8') === 'hello');
t('base64 invalid throws', throws(() => d.base64Decode('***')));
t('url roundtrip', d.urlDecode(d.urlEncode('a b&c=d/é')) === 'a b&c=d/é');
t('uuid shape', /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(d.uuidV4()));
t('uuid unique', d.uuidV4() !== d.uuidV4());
t('sha256 known', await d.shaHex('SHA-256', 'abc') === 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad');
t('sha1 known', await d.shaHex('SHA-1', 'abc') === 'a9993e364706816aba3e25717850c26c9cd0d89d');
const jwt = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwiZXhwIjoxNzAwMDAwMDAwfQ.sig';
const dj = JSON.parse(d.decodeJwt(jwt));
t('jwt header+payload', dj.header.alg === 'HS256' && dj.payload.sub === '1234567890');
t('jwt exp iso', dj.exp_iso === '2023-11-14T22:13:20.000Z');
t('jwt not verified note', dj.note.includes('not verified'));
t('jwt bad throws', throws(() => d.decodeJwt('abc')));
t('timestamp seconds', d.timestampConvert('1700000000').startsWith('2023-11-14T22:13:20.000Z'));
t('timestamp ms', d.timestampConvert('1700000000000').startsWith('2023-11-14T22:13:20.000Z'));
t('timestamp iso->unix', d.timestampConvert('2023-11-14T22:13:20Z').startsWith('1700000000 '));
t('timestamp bad throws', throws(() => d.timestampConvert('nope')));
t('color hex', d.colorConvert('#E5222A').includes('rgb(229, 34, 42)'));
t('color short hex', d.colorConvert('#fff').includes('HEX  #FFFFFF'));
t('color rgb in', d.colorConvert('rgb(0, 0, 0)').includes('hsl(0, 0%, 0%)'));
t('color black/white contrast 21', d.colorConvert('#000').includes('on white 21.00:1') && d.colorConvert('#fff').includes('on black 21.00:1'));
t('color invalid throws', throws(() => d.colorConvert('banana')));
t('color rgb range', throws(() => d.colorConvert('rgb(300,0,0)')));
const r = d.testRegex('(\\d+)-(\\w)', 'g', 'a 12-x b 7-y');
t('regex matches+groups', r.matches.length === 2 && r.matches[0].groups[0] === '12' && r.matches[1].index === 9);
t('regex invalid reported', !!d.testRegex('(', '', 'x').error);
t('regex empty match terminates', d.testRegex('x*', 'g', 'abc').matches.length >= 3);
t('regex empty pattern', d.testRegex('', 'g', 'abc').matches.length === 0);
t('stats', d.textStats('a b\nc') === '2 lines, 3 words, 5 characters, 5 bytes');
console.log(`\n${pass} passed, ${fail} failed`); process.exit(fail ? 1 : 0);
