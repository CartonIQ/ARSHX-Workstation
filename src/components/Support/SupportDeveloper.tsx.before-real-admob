import React, { useState } from 'react';
import { Capacitor } from '@capacitor/core';
import {
  AdMob,
  AdmobConsentStatus,
  RewardAdPluginEvents,
} from '@capacitor-community/admob';

const TEST_REWARDED_AD_ID = 'ca-app-pub-3940256099942544/5224354917';

export const SupportDeveloper: React.FC = () => {
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState('');

  const watchAd = async () => {
    if (busy) return;

    if (!Capacitor.isNativePlatform()) {
      setMessage('Support ads are available in the Android app.');
      return;
    }

    setBusy(true);
    setMessage('');

    let rewarded = false;
    let dismissed = false;
    let failed = false;
    const handles: Array<{ remove: () => Promise<void> }> = [];

    try {
      const consent = await AdMob.requestConsentInfo();

      if (consent.isConsentFormAvailable &&
          consent.status === AdmobConsentStatus.REQUIRED) {
        await AdMob.showConsentForm();
      }

      const latestConsent = await AdMob.requestConsentInfo();

      if (!latestConsent.canRequestAds) {
        setMessage('Ads are unavailable until consent requirements are resolved.');
        return;
      }

      await AdMob.initialize({ initializeForTesting: true });

      handles.push(
        await AdMob.addListener(RewardAdPluginEvents.Rewarded, () => {
          rewarded = true;
          setMessage('❤️ Thank you for supporting ARSHX!');
        }),
        await AdMob.addListener(RewardAdPluginEvents.Dismissed, () => {
          dismissed = true;
          if (!rewarded) setMessage('No reward this time. Thanks for trying!');
        }),
        await AdMob.addListener(RewardAdPluginEvents.FailedToLoad, () => {
          failed = true;
          setMessage('The ad could not load. Please try again later.');
        }),
        await AdMob.addListener(RewardAdPluginEvents.FailedToShow, () => {
          failed = true;
          setMessage('The ad could not be shown. Please try again.');
        }),
      );

      await AdMob.prepareRewardVideoAd({
        adId: TEST_REWARDED_AD_ID,
        isTesting: true,
      });

      if (!failed) {
        const reward = await AdMob.showRewardVideoAd();
        if (reward && !rewarded) {
          rewarded = true;
          setMessage('❤️ Thank you for supporting ARSHX!');
        }
      }
    } catch {
      setMessage('Ad unavailable right now. Please try again later.');
    } finally {
      await Promise.all(handles.map(handle => handle.remove().catch(() => undefined)));
      setBusy(false);
    }
  };

  return (
    <section className="rounded-2xl border border-[#E5222A]/40 bg-[#1A1A20] p-4 sm:p-5">
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 className="font-bold text-white">❤️ Support the Developer</h3>
          <p className="mt-1 text-xs leading-relaxed text-[#A5A5B2]">
            Enjoying ARSHX? You can optionally watch a short rewarded ad to support development.
          </p>
        </div>
        <button
          type="button"
          onClick={watchAd}
          disabled={busy}
          className="shrink-0 rounded-xl bg-[#E5222A] px-4 py-3 text-xs font-bold text-white transition hover:bg-[#d01c24] disabled:cursor-wait disabled:opacity-60"
        >
          {busy ? 'Loading ad…' : '❤️ Watch Ad'}
        </button>
      </div>
      {message && (
        <p role="status" className="mt-3 text-xs text-[#F7F7FA]">
          {message}
        </p>
      )}
    </section>
  );
};
